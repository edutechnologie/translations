#: lti_1p3/extensions/rest_framework/authentication.py:41
msgid "Missing LTI 1.3 authentication token."
msgstr "Brak tokenu uwierzytelniającego LTI 1.3."

#: lti_1p3/extensions/rest_framework/authentication.py:45
msgid "Invalid token header. No credentials provided."
msgstr "Nieprawidłowy nagłówek tokenu. Nie podano danych uwierzytelniających."

#: lti_1p3/extensions/rest_framework/authentication.py:49
msgid "Invalid token header. Token string should not contain spaces."
msgstr ""
"Nieprawidłowy nagłówek tokenu. Ciąg tokenu nie powinien zawierać spacji."

#: lti_1p3/extensions/rest_framework/authentication.py:57
msgid "LTI configuration not found."
msgstr "Nie znaleziono konfiguracji LTI."

#: lti_1p3/extensions/rest_framework/authentication.py:66
msgid "Invalid token signature."
msgstr "Nieprawidłowy podpis tokenu."

#: lti_xblock.py:133
msgid "No valid user id found in endpoint URL"
msgstr ""
"Nie znaleziono prawidłowego identyfikatora użytkownika w adresie URL punktu "
"końcowego"

#: lti_xblock.py:146
msgid "Configuration on block"
msgstr "Konfiguracja na bloku"

#: lti_xblock.py:150
msgid "Database Configuration"
msgstr "Konfiguracja bazy danych"

#: lti_xblock.py:153
msgid "Reusable Configuration"
msgstr "Konfiguracja wielokrotnego użytku"

#: lti_xblock.py:261
msgid "Display Name"
msgstr "Nazwa wyświetlana"

#: lti_xblock.py:263
msgid ""
"Enter the name that students see for this component. Analytics reports may "
"also use the display name to identify this component."
msgstr ""
"Wprowadź nazwę, którą uczniowie widzą dla tego komponentu. Raporty "
"analityczne mogą również używać nazwy wyświetlanej do identyfikacji tego "
"komponentu."

#: lti_xblock.py:267
msgid "LTI Consumer"
msgstr "Klient LTI"

#: lti_xblock.py:270
msgid "LTI Application Information"
msgstr "Informacje o aplikacji LTI"

#: lti_xblock.py:272
msgid ""
"Enter a description of the third party application. If requesting username "
"and/or email, use this text box to inform users why their username and/or "
"email will be forwarded to a third party application."
msgstr ""
"Wprowadź opis aplikacji strony trzeciej. Jeśli żądasz nazwy użytkownika "
"i/lub adresu e-mail, użyj tego pola tekstowego, aby poinformować "
"użytkowników, dlaczego ich nazwa użytkownika i/lub adres e-mail zostaną "
"przekazane do aplikacji strony trzeciej."

#: lti_xblock.py:280
msgid "Configuration Type"
msgstr "Typ konfiguracji"

#: lti_xblock.py:285
msgid ""
"Select 'Configuration on block' to configure a new LTI Tool. If the support "
"staff provided you with a pre-configured LTI reusable Tool ID, "
"select'Reusable Configuration' and enter it in the text field below."
msgstr ""
"Wybierz 'Konfiguracja na bloku', aby skonfigurować nowe narzędzie LTI. Jeśli"
" personel pomocniczy dostarczył Ci wstępnie skonfigurowany identyfikator "
"narzędzia LTI wielokrotnego użytku, wybierz 'Konfiguracja wielokrotnego "
"użytku' i wprowadź go w polu tekstowym poniżej."

#: lti_xblock.py:292
msgid "LTI Version"
msgstr "Wersja LTI"

#: lti_xblock.py:300
msgid ""
"Select the LTI version that your tool supports.<br />The XBlock LTI Consumer"
" fully supports LTI 1.1.1, LTI 1.3 and LTI Advantage features."
msgstr ""
"Wybierz wersję LTI, którą obsługuje Twoje narzędzie.<br />Klient LTI XBlock "
"w pełni obsługuje funkcje LTI 1.1.1, LTI 1.3 i LTI Advantage."

#: lti_xblock.py:307
msgid "LTI Reusable Configuration ID"
msgstr "Identyfikator konfiguracji LTI wielokrotnego użytku"

#: lti_xblock.py:309
msgid ""
"Enter the reusable LTI external configuration ID provided by the support "
"staff."
msgstr ""
"Wprowadź identyfikator konfiguracji zewnętrznej LTI wielokrotnego użytku "
"dostarczony przez personel pomocniczy."

#: lti_xblock.py:314
msgid "Tool Launch URL"
msgstr "Adres URL uruchomienia narzędzia"

#: lti_xblock.py:318
msgid ""
"Enter the LTI 1.3 Tool Launch URL. <br />This is the URL the LMS will use to"
" launch the LTI Tool."
msgstr ""
"Wprowadź adres URL uruchomienia narzędzia LTI 1.3. <br />Jest to adres URL, "
"którego LMS użyje do uruchomienia narzędzia LTI."

#: lti_xblock.py:323
msgid "Tool Initiate Login URL"
msgstr "Adres URL inicjowania logowania narzędzia"

#: lti_xblock.py:327
msgid ""
"Enter the LTI 1.3 Tool OIDC Authorization url (can also be called login or "
"login initiation URL).<br />This is the URL the LMS will use to start a LTI "
"authorization prior to doing the launch request."
msgstr ""
"Wprowadź adres URL autoryzacji OIDC narzędzia LTI 1.3 (może być również "
"nazywany adresem URL logowania lub inicjowania logowania).<br />Jest to "
"adres URL, którego LMS użyje do rozpoczęcia autoryzacji LTI przed wykonaniem"
" żądania uruchomienia."

#: lti_xblock.py:333
msgid "Registered Redirect URIs"
msgstr "Zarejestrowane adresy URL przekierowania"

#: lti_xblock.py:335
msgid ""
"Valid urls the Tool may request us to redirect the id token to. The redirect"
" uris are often the same as the launch url/deep linking url so if this field"
" is empty, it will use them as the default. If you need to use different "
"redirect uri's, enter them here. If you use this field you must enter all "
"valid redirect uri's the tool may request."
msgstr ""
"Prawidłowe adresy URL, do których Narzędzie może nas poprosić o "
"przekierowanie tokenu identyfikacyjnego. Adresy URL przekierowania są często"
" takie same jak adres URL uruchomienia/adres URL głębokiego linkowania, więc"
" jeśli to pole jest puste, będą one używane domyślnie. Jeśli potrzebujesz "
"użyć różnych adresów URL przekierowania, wprowadź je tutaj. Jeśli używasz "
"tego pola, musisz wprowadzić wszystkie prawidłowe adresy URL przekierowania,"
" o które może prosić narzędzie."

#: lti_xblock.py:345
msgid "Tool Public Key Mode"
msgstr "Tryb klucza publicznego narzędzia"

#: lti_xblock.py:353
msgid "Select how the tool's public key information will be specified."
msgstr ""
"Wybierz, w jaki sposób będą podawane informacje o kluczu publicznym "
"narzędzia."

#: lti_xblock.py:357
msgid "Tool Keyset URL"
msgstr "Adres URL zestawu kluczy narzędzia"

#: lti_xblock.py:361
msgid ""
"Enter the LTI 1.3 Tool's JWK keysets URL.<br />This link should retrieve a "
"JSON file containing public keys and signature algorithm information, so "
"that the LMS can check if the messages and launch requests received have the"
" signature from the tool.<br /><b>This is not required when doing LTI 1.3 "
"Launches without LTI Advantage nor Basic Outcomes requests.</b>"
msgstr ""
"Wprowadź adres URL zestawu kluczy JWK narzędzia LTI 1.3.<br />Ten link "
"powinien pobrać plik JSON zawierający klucze publiczne i informacje o "
"algorytmie podpisu, aby LMS mógł sprawdzić, czy otrzymane wiadomości i "
"żądania uruchomienia mają podpis narzędzia.<br /><b>Nie jest to wymagane "
"podczas uruchamiania LTI 1.3 bez LTI Advantage ani żądań Basic Outcomes.</b>"

#: lti_xblock.py:371
msgid "Tool Public Key"
msgstr "Klucz publiczny narzędzia"

#: lti_xblock.py:376
msgid ""
"Enter the LTI 1.3 Tool's public key.<br />This is a string that starts with "
"'-----BEGIN PUBLIC KEY-----' and is required so that the LMS can check if "
"the messages and launch requests received have the signature from the "
"tool.<br /><b>This is not required when doing LTI 1.3 Launches without LTI "
"Advantage nor Basic Outcomes requests.</b>"
msgstr ""
"Wprowadź klucz publiczny narzędzia LTI 1.3.<br />Jest to ciąg znaków "
"zaczynający się od '-----BEGIN PUBLIC KEY-----' i jest wymagany, aby LMS "
"mógł sprawdzić, czy otrzymane wiadomości i żądania uruchomienia mają podpis "
"narzędzia.<br /><b>Nie jest to wymagane podczas uruchamiania LTI 1.3 bez LTI"
" Advantage ani żądań Basic Outcomes.</b>"

#: lti_xblock.py:386
msgid "Enable LTI NRPS"
msgstr "Włącz LTI NRPS"

#: lti_xblock.py:387
msgid "Enable LTI Names and Role Provisioning Services."
msgstr "Włącz usługi udostępniania nazw i ról LTI."

#: lti_xblock.py:394
msgid "Deep linking"
msgstr "Głębokie linkowanie"

#: lti_xblock.py:395
msgid "Select True if you want to enable LTI Advantage Deep Linking."
msgstr ""
"Wybierz Prawda, jeśli chcesz włączyć głębokie linkowanie LTI Advantage."

#: lti_xblock.py:400
msgid "Deep Linking Launch URL"
msgstr "Adres URL uruchomienia głębokiego linkowania"

#: lti_xblock.py:404
msgid ""
"Enter the LTI Advantage Deep Linking Launch URL. If the tool does not "
"specify one, use the same value as 'Tool Launch URL'."
msgstr ""
"Wprowadź adres URL uruchomienia głębokiego linkowania LTI Advantage. Jeśli "
"narzędzie nie określi jednego, użyj tej samej wartości co 'Adres URL "
"uruchomienia narzędzia'."

#: lti_xblock.py:409
msgid "LTI Assignment and Grades Service"
msgstr "Usługa przypisywania i ocen LTI"

#: lti_xblock.py:411
msgid "Disabled"
msgstr "Wyłączone"

#: lti_xblock.py:412
msgid "Allow tools to submit grades only (declarative)"
msgstr "Zezwól narzędziom na przesyłanie ocen tylko (deklaratywnie)"

#: lti_xblock.py:413
msgid "Allow tools to manage and submit grade (programmatic)"
msgstr "Zezwól narzędziom na zarządzanie i przesyłanie ocen (programowo)"

#: lti_xblock.py:418
msgid ""
"Enable the LTI-AGS service and select the functionality enabled for LTI "
"tools. The 'declarative' mode (default) will provide a tool with a LineItem "
"created from the XBlock settings, while the 'programmatic' one will allow "
"tools to manage, create and link the grades."
msgstr ""
"Włącz usługę LTI-AGS i wybierz funkcjonalność włączoną dla narzędzi LTI. "
"Tryb 'deklaratywny' (domyślny) zapewni narzędziu LineItem utworzony na "
"podstawie ustawień XBlock, podczas gdy tryb 'programowy' pozwoli narzędziom "
"na zarządzanie, tworzenie i linkowanie ocen."

#: lti_xblock.py:426
msgid "LTI ID"
msgstr "Identyfikator LTI"

#: lti_xblock.py:428
#, python-brace-format
msgid ""
"Enter the LTI ID for the external LTI provider. This value must be the same "
"LTI ID that you entered in the LTI Passports setting on the Advanced "
"Settings page.<br />See the {docs_anchor_open}edX LTI "
"documentation{anchor_close} for more details on this setting."
msgstr ""
"Wprowadź identyfikator LTI dla zewnętrznego dostawcy LTI. Ta wartość musi "
"być tym samym identyfikatorem LTI, który wprowadziłeś w ustawieniu LTI "
"Passports na stronie Ustawienia zaawansowane.<br />Zobacz "
"{docs_anchor_open}dokumentację edX LTI{anchor_close}, aby uzyskać więcej "
"informacji na temat tego ustawienia."

#: lti_xblock.py:440
msgid "LTI URL"
msgstr "Adres URL LTI"

#: lti_xblock.py:442
#, python-brace-format
msgid ""
"Enter the URL of the external tool that this component launches. This "
"setting is only used when Hide External Tool is set to False.<br />See the "
"{docs_anchor_open}edX LTI documentation{anchor_close} for more details on "
"this setting."
msgstr ""
"Wprowadź adres URL zewnętrznego narzędzia, które uruchamia ten komponent. To"
" ustawienie jest używane tylko wtedy, gdy Ukryj zewnętrzne narzędzie jest "
"ustawione na Fałsz.<br /> Zobacz {docs_anchor_open}dokumentację edX "
"LTI{anchor_close}, aby uzyskać więcej informacji na temat tego ustawienia."

#: lti_xblock.py:455
msgid "Custom Parameters"
msgstr "Parametry niestandardowe"

#: lti_xblock.py:457
#, python-brace-format
msgid ""
"Add the key/value pair for any custom parameters, such as the page your "
"e-book should open to or the background color for this component. Ex. "
"[\"page=1\", \"color=white\"]<br />See the {docs_anchor_open}edX LTI "
"documentation{anchor_close} for more details on this setting."
msgstr ""
"Dodaj parę klucz/wartość dla wszelkich niestandardowych parametrów, takich "
"jak strona, na której ma zostać otwarta Twoja e-książka, lub kolor tła dla "
"tego komponentu. Np. [\"page=1\", \"color=white\"]<br /> Zobacz "
"{docs_anchor_open}dokumentację edX LTI{anchor_close}, aby uzyskać więcej "
"informacji na temat tego ustawienia."

#: lti_xblock.py:467
msgid "LTI Launch Target"
msgstr "Cel uruchomienia LTI"

#: lti_xblock.py:469
msgid ""
"Select Inline if you want the LTI content to open in an IFrame in the "
"current page. Select Modal if you want the LTI content to open in a modal "
"window in the current page. Select New Window if you want the LTI content to"
" open in a new browser window. This setting is only used when Hide External "
"Tool is set to False."
msgstr ""
"Wybierz Inline, jeśli chcesz, aby zawartość LTI otwierała się w ramce IFrame"
" na bieżącej stronie. Wybierz Modal, jeśli chcesz, aby zawartość LTI "
"otwierała się w oknie modalnym na bieżącej stronie. Wybierz Nowe okno, jeśli"
" chcesz, aby zawartość LTI otwierała się w nowym oknie przeglądarki. To "
"ustawienie jest używane tylko wtedy, gdy Ukryj zewnętrzne narzędzie jest "
"ustawione na Fałsz."

#: lti_xblock.py:483
msgid "Button Text"
msgstr "Tekst przycisku"

#: lti_xblock.py:485
msgid ""
"Enter the text on the button used to launch the third party application. "
"This setting is only used when Hide External Tool is set to False and LTI "
"Launch Target is set to Modal or New Window."
msgstr ""
"Wprowadź tekst na przycisku używanym do uruchomienia aplikacji strony "
"trzeciej. To ustawienie jest używane tylko wtedy, gdy Ukryj zewnętrzne "
"narzędzie jest ustawione na Fałsz, a Cel uruchomienia LTI jest ustawiony na "
"Modal lub Nowe okno."

#: lti_xblock.py:493
msgid "Inline Height"
msgstr "Wysokość Inline"

#: lti_xblock.py:495
msgid ""
"Enter the desired pixel height of the iframe which will contain the LTI "
"tool. This setting is only used when Hide External Tool is set to False and "
"LTI Launch Target is set to Inline."
msgstr ""
"Wprowadź żądaną wysokość w pikselach ramki iframe, która będzie zawierać "
"narzędzie LTI. To ustawienie jest używane tylko wtedy, gdy Ukryj zewnętrzne "
"narzędzie jest ustawione na Fałsz, a Cel uruchomienia LTI jest ustawiony na "
"Inline."

#: lti_xblock.py:503
msgid "Modal Height"
msgstr "Wysokość okna modalnego"

#: lti_xblock.py:505
msgid ""
"Enter the desired viewport percentage height of the modal overlay which will"
" contain the LTI tool. This setting is only used when Hide External Tool is "
"set to False and LTI Launch Target is set to Modal."
msgstr ""
"Wprowadź żądany procent wysokości widoku nakładki modalnej, która będzie "
"zawierać narzędzie LTI. To ustawienie jest używane tylko wtedy, gdy Ukryj "
"zewnętrzne narzędzie jest ustawione na Fałsz, a Cel uruchomienia LTI jest "
"ustawiony na Modal."

#: lti_xblock.py:513
msgid "Modal Width"
msgstr "Szerokość okna modalnego"

#: lti_xblock.py:515
msgid ""
"Enter the desired viewport percentage width of the modal overlay which will "
"contain the LTI tool. This setting is only used when Hide External Tool is "
"set to False and LTI Launch Target is set to Modal."
msgstr ""
"Wprowadź żądany procent szerokości widoku nakładki modalnej, która będzie "
"zawierać narzędzie LTI. To ustawienie jest używane tylko wtedy, gdy Ukryj "
"zewnętrzne narzędzie jest ustawione na Fałsz, a Cel uruchomienia LTI jest "
"ustawiony na Modal."

#: lti_xblock.py:523
msgid "Scored"
msgstr "Oceniane"

#: lti_xblock.py:524
msgid ""
"Select True if this component will receive a numerical score from the "
"external LTI system."
msgstr ""
"Wybierz Prawda, jeśli ten komponent otrzyma ocenę liczbową z zewnętrznego "
"systemu LTI."

#: lti_xblock.py:531
msgid ""
"Enter the number of points possible for this component.  The default value "
"is 1.0.  This setting is only used when Scored is set to True."
msgstr ""
"Wprowadź liczbę punktów możliwych do uzyskania dla tego komponentu. Domyślna"
" wartość to 1.0. To ustawienie jest używane tylko wtedy, gdy Oceniane jest "
"ustawione na Prawda."

#: lti_xblock.py:540
msgid ""
"The score kept in the xblock KVS -- duplicate of the published score in "
"django DB"
msgstr ""
"Wynik przechowywany w KVS xblock -- duplikat opublikowanego wyniku w bazie "
"danych django"

#: lti_xblock.py:545
msgid "Comment as returned from grader, LTI2.0 spec"
msgstr "Komentarz zwrócony przez oceniającego, specyfikacja LTI2.0"

#: lti_xblock.py:550
msgid "Hide External Tool"
msgstr "Ukryj zewnętrzne narzędzie"

#: lti_xblock.py:552
msgid ""
"Select True if you want to use this component as a placeholder for syncing "
"with an external grading  system rather than launch an external tool.  This "
"setting hides the Launch button and any IFrames for this component."
msgstr ""
"Wybierz Prawda, jeśli chcesz użyć tego komponentu jako symbolu zastępczego "
"do synchronizacji z zewnętrznym systemem oceniania, zamiast uruchamiać "
"zewnętrzne narzędzie. To ustawienie ukrywa przycisk Uruchom i wszelkie ramki"
" iframe dla tego komponentu."

#: lti_xblock.py:560
msgid "Accept grades past deadline"
msgstr "Akceptuj oceny po terminie"

#: lti_xblock.py:561
msgid ""
"Select True to allow third party systems to post grades past the deadline."
msgstr ""
"Wybierz Prawda, aby zezwolić systemom stron trzecich na przesyłanie ocen po "
"terminie."

#: lti_xblock.py:569
msgid "Request user's username"
msgstr "Poproś o nazwę użytkownika"

#. Translators: This is used to request the user's username for a third party
#. service.
#: lti_xblock.py:571
msgid "Select True to request the user's username."
msgstr "Wybierz Prawda, aby poprosić o nazwę użytkownika."

#: lti_xblock.py:576
msgid "Request user's full name"
msgstr "Poproś o pełną nazwę użytkownika"

#. Translators: This is used to request the user's full name for a third party
#. service.
#: lti_xblock.py:578
msgid "Select True to request the user's full name."
msgstr "Wybierz Prawda, aby poprosić o pełną nazwę użytkownika."

#: lti_xblock.py:583
msgid "Request user's email"
msgstr "Poproś o e-mail użytkownika"

#. Translators: This is used to request the user's email for a third party
#. service.
#: lti_xblock.py:585
msgid "Select True to request the user's email address."
msgstr "Wybierz Prawda, aby poprosić o adres e-mail użytkownika."

#: lti_xblock.py:591
msgid "Send extra parameters"
msgstr "Wyślij dodatkowe parametry"

#: lti_xblock.py:592
msgid ""
"Select True to send the extra parameters, which might contain Personally "
"Identifiable Information. The processors are site-wide, please consult the "
"site administrator if you have any questions."
msgstr ""
"Wybierz Prawda, aby wysłać dodatkowe parametry, które mogą zawierać dane "
"osobowe. Procesory są ogólnosystemowe, skonsultuj się z administratorem "
"witryny, jeśli masz jakiekolwiek pytania."

#: lti_xblock.py:667
msgid "Custom Parameters must be a list"
msgstr "Parametry niestandardowe muszą być listą"

#: lti_xblock.py:674
msgid "Custom Parameters should be strings in \"x=y\" format."
msgstr "Parametry niestandardowe powinny być ciągami znaków w formacie \"x=y\"."

#: lti_xblock.py:684
msgid ""
"Reusable configuration ID must be set when using external config (Example: "
"\"x:y\")."
msgstr ""
"Identyfikator konfiguracji wielokrotnego użytku musi być ustawiony podczas "
"używania konfiguracji zewnętrznej (Przykład: \"x:y\")."

#: lti_xblock.py:708
msgid ""
"The specified LTI ID is not configured in this course's Advanced Settings."
msgstr ""
"Podany identyfikator LTI nie jest skonfigurowany w zaawansowanych "
"ustawieniach tego kursu."

#: lti_xblock.py:837 lti_xblock.py:1128
msgid "Could not get user data for current request"
msgstr "Nie można uzyskać danych użytkownika dla bieżącego żądania"

#: lti_xblock.py:877
msgid ""
"Could not parse LTI passport: {lti_passport!r}. Should be \"id:key:secret\" "
"string."
msgstr ""
"Nie można sparsować paszportu LTI: {lti_passport!r}. Powinien to być ciąg "
"znaków \"id:klucz:sekret\"."

#: lti_xblock.py:895 lti_xblock.py:909 lti_xblock.py:925
msgid "Could not get user id for current request"
msgstr "Nie można uzyskać identyfikatora użytkownika dla bieżącego żądania"

#: lti_xblock.py:1061
msgid ""
"Could not parse custom parameter: {custom_parameter!r}. Should be \"x=y\" "
"string."
msgstr ""
