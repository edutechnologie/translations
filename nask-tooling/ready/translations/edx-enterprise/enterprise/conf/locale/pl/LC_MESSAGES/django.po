msgstr "Określa, czy strona zgody na udostępnianie danych jest opublikowana."

#: integrated_channels/canvas/models.py:112
msgid ""
"Account number to use during api calls. Called account_id in canvas.  "
"Required to create courses etc."
msgstr ""
"Numer konta do wykorzystania podczas wywołań API. Nazywany account_id w "
"Canvas. Wymagany do tworzenia kursów itp."

#: integrated_channels/canvas/models.py:121
msgid ""
"The base URL used for API requests to Canvas, i.e. https://instructure.com."
msgstr ""
"Podstawowy adres URL używany do żądań API do Canvas, np. "
"https://instructure.com."

#: integrated_channels/canvas/models.py:128
msgid ""
"The refresh token provided by Canvas along with the access token request, "
"used to re-request the access tokens over multiple client sessions."
msgstr ""
"Token odświeżania udostępniany przez Canvas wraz z żądaniem tokena dostępu, "
"używany do ponownego żądania tokenów dostępu w wielu sesjach klienta."

#: integrated_channels/canvas/models.py:135
#: integrated_channels/integrated_channel/models.py:155
#: integrated_channels/moodle/models.py:163
#: integrated_channels/sap_success_factors/models.py:198
msgid ""
"The maximum number of data items to transmit to the integrated channel with "
"each request."
msgstr ""
"Maksymalna liczba elementów danych do przesłania do zintegrowanego kanału z "
"każdym żądaniem."

#: integrated_channels/canvas/models.py:247
msgid "The amount of points that the learner scored on the subsection."
msgstr "Liczba punktów, które uczeń zdobył w podsekcji."

#: integrated_channels/canvas/models.py:253
msgid ""
"The total amount of points that the learner could score on the subsection."
msgstr "Całkowita liczba punktów, które uczeń mógł zdobyć w podsekcji."

#: integrated_channels/canvas/models.py:326
msgid ""
"Represents the canvas representation of a timestamp: yyyy-mm-dd, which is "
"always 10 characters. Can be left unset for audit transmissions."
msgstr ""
"Reprezentuje reprezentację Canvas znacznika czasu: rrrr-mm-dd, który zawsze "
"ma 10 znaków. Może pozostać nieustawiony dla transmisji audytu."

#: integrated_channels/cornerstone/models.py:39
msgid "The API path for making completion POST requests to Cornerstone."
msgstr ""
"Ścieżka API do wysyłania żądań POST dotyczących ukończenia do Cornerstone."

#: integrated_channels/cornerstone/models.py:46
msgid ""
"The API path for making OAuth-related POST requests to Cornerstone. This "
"will be used to gain the OAuth access token which is required for other API "
"calls."
msgstr ""
"Ścieżka API do wysyłania żądań POST związanych z OAuth do Cornerstone. "
"Będzie używana do uzyskania tokena dostępu OAuth, który jest wymagany do "
"innych wywołań API."

#: integrated_channels/cornerstone/models.py:55
msgid "Basic auth username for sending user completion status to cornerstone."
msgstr ""
"Nazwa użytkownika uwierzytelniania podstawowego do wysyłania statusu "
"ukończenia użytkownika do Cornerstone."

#: integrated_channels/cornerstone/models.py:61
msgid "Basic auth password for sending user completion status to cornerstone."
msgstr ""
"Hasło uwierzytelniania podstawowego do wysyłania statusu ukończenia "
"użytkownika do Cornerstone."

#: integrated_channels/cornerstone/models.py:66
msgid "Key/value mapping cornerstone subjects to edX subjects list"
msgstr ""
"Mapowanie klucz/wartość przedmiotów Cornerstone do listy przedmiotów edX"

#: integrated_channels/cornerstone/models.py:71
msgid "List of IETF language tags supported by cornerstone"
msgstr "Lista tagów językowych IETF obsługiwanych przez Cornerstone"

#: integrated_channels/cornerstone/models.py:100
msgid ""
"The base URL used for API requests to Cornerstone, i.e. "
"https://portalName.csod.com"
msgstr ""
"Podstawowy adres URL używany do żądań API do Cornerstone, np. "
"https://portalName.csod.com"

#: integrated_channels/cornerstone/models.py:108
msgid ""
"The most current session token provided for authorization to make API calls "
