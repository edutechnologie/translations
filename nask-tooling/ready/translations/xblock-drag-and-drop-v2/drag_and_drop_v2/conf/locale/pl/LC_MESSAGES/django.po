msgstr "Zapisz"

#: templates/html/drag_and_drop_edit.html:296
msgid "Cancel"
msgstr "Anuluj"

#: utils.py:121
#, python-brace-format
msgid "Your highest score is {score}"
msgstr "Twój najwyższy wynik to {score}"

#: utils.py:122
#, python-brace-format
msgid "Final attempt was used, highest score is {score}"
msgstr "Ostatnia próba została wykorzystana, najwyższy wynik to {score}"

#: utils.py:130
#, python-brace-format
msgid "Correctly placed {correct_count} item"
msgid_plural "Correctly placed {correct_count} items"
msgstr[0] "Poprawnie umieszczono {correct_count} element"
msgstr[1] "Poprawnie umieszczono {correct_count} elementy"
msgstr[2] "Poprawnie umieszczono {correct_count} elementów"

#: utils.py:141
#, python-brace-format
msgid "Misplaced {misplaced_count} item"
msgid_plural "Misplaced {misplaced_count} items"
msgstr[0] "Błędnie umieszczono {misplaced_count} element"
msgstr[1] "Błędnie umieszczono {misplaced_count} elementy"
msgstr[2] "Błędnie umieszczono {misplaced_count} elementów"

#: utils.py:152
#, python-brace-format
msgid ""
"Misplaced {misplaced_count} item (misplaced item was returned to the item "
"bank)"
msgid_plural ""
"Misplaced {misplaced_count} items (misplaced items were returned to the item"
" bank)"
msgstr[0] ""
"Błędnie umieszczono {misplaced_count} element (błędnie umieszczony element "
"został zwrócony do banku elementów)"
msgstr[1] ""
"Błędnie umieszczono {misplaced_count} elementy (błędnie umieszczone elementy"
" zostały zwrócone do banku elementów)"
msgstr[2] ""
"Błędnie umieszczono {misplaced_count} elementów (błędnie umieszczone "
"elementy zostały zwrócone do banku elementów)"

#: utils.py:163
#, python-brace-format
